# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# The application reads this file itself on startup - application.properties
# imports it with `spring.config.import=optional:file:./.env[.properties]` - so
# `mvnw spring-boot:run` from the project directory needs nothing exported into
# the shell first. The import is optional, so a deployment that supplies real
# environment variables instead simply has no file to find.
#
# It is parsed as a .properties file, so values run literally to the end of the
# line: no quotes, no `export` prefix, and a `#` begins a comment.

# Database
DATASOURCE_URL=
DATASOURCE_USER=
DATASOURCE_PASSWORD=

# Absolute path for uploaded DC documents
DC_UPLOAD_PATH=

# Origin allowed to call this API, e.g. http://localhost:3000
FRONTEND_URL=

# Base64-encoded signing key, at least 32 bytes. Generate with:
#   openssl rand -base64 48
JWT_SECRET=
# Optional, defaults to 86400000 (24h)
JWT_EXPIRATION_MS=
