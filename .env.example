# Copy to .env and fill in. .env is gitignored and must never be committed.

# Database
DATASOURCE_URL=
DATASOURCE_USER=
DATASOURCE_PASSWORD=

# Absolute path for uploaded DC documents
DC_UPLOAD_PATH=

# Origin allowed to call this API, e.g. http://localhost:3000
FRONTEND_URL=

# Base64-encoded signing key, at least 32 bytes. Generate with:
#   openssl rand -base64 48
JWT_SECRET=
# Optional, defaults to 86400000 (24h)
JWT_EXPIRATION_MS=
