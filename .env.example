# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# The application reads this file itself on startup - application.properties
# imports it with `spring.config.import=optional:file:./.env[.properties]` - so
# `mvnw spring-boot:run` from the project directory needs nothing exported into
# the shell first. The import is optional, so a deployment that supplies real
# environment variables instead simply has no file to find.
#
# It is parsed as a .properties file, so values run literally to the end of the
# line: no quotes, no `export` prefix, and a `#` begins a comment.
#
# ENV is NOT read from here - it has to be a real environment variable, because it
# decides which of these files and which database are used before this one is even
# loaded. There is no default, and the application refuses to start without it:
#
#     PowerShell:  $env:ENV = "prod"; .\mvnw.cmd spring-boot:run
#     Bash:        ENV=prod ./mvnw spring-boot:run
#
#     ENV=prod -> poultry_db (live)   ENV=test -> poultry_db_test   ENV=dev -> poultry_db_dev

# Database. DATASOURCE_URL is used by the prod profile only; the dev and test
# profiles name their own database and take just the username and password from
# here, so one .env serves all three.
DATASOURCE_URL=
DATASOURCE_USER=
DATASOURCE_PASSWORD=

# Absolute path for uploaded DC documents
DC_UPLOAD_PATH=

# Origin allowed to call this API, e.g. http://localhost:3000
FRONTEND_URL=

# Base64-encoded signing key, at least 32 bytes. Generate with:
#   openssl rand -base64 48
JWT_SECRET=
# Optional, defaults to 86400000 (24h)
JWT_EXPIRATION_MS=

# --- Messaging (Fast2SMS) ----------------------------------------------------
# The API key used to be a constant in SendSmsService.java and is still in git
# history, so it needs rotating in the Fast2SMS dashboard, not just moving here.
FAST2SMS_API_KEY=
# DLT sender id registered with the operator
FAST2SMS_SENDER_ID=SHLCKN
# Approved DLT template id for the daily SMS
FAST2SMS_SMS_TEMPLATE_ID=195555
# WhatsApp business number id on the Fast2SMS account
FAST2SMS_WA_PHONE_NUMBER_ID=
FAST2SMS_WA_SALE_TEMPLATE_ID=12082
FAST2SMS_WA_PAYMENT_TEMPLATE_ID=12083
# The 8-variable daily summary template. Registered as daily_sale_summary,
# message_id 32340 - see docs/whatsapp-templates.md. Messages are held until Meta
# approves it, so setting it before approval is safe.
FAST2SMS_WA_DAILY_TEMPLATE_ID=32340

# Leave false until the customer numbers are cleaned up. With it false, messages
# are still written to message_outbox in full and left PENDING, so a day's sends
# can be read before any customer receives one.
MESSAGING_ENABLED=false
# SMS or WHATSAPP
MESSAGING_CHANNEL=SMS
